        <com.google.android.material.button.MaterialButton android:id="@+id/btn_7_2" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_7_3" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_7_4" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_7_5" style="@style/FiftyToneButtonStyle"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_8_1" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_8_2" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_8_3" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_8_4" android:text="删除" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_8_5" android:text="ー" style="@style/FiftyToneButtonStyle"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_9_1" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_9_2" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_9_3" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_9_4" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_9_5" style="@style/FiftyToneButtonStyle"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_10_1" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_10_2" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_10_3" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_10_4" android:text="假名" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_10_5" android:text="促音" style="@style/FiftyToneButtonStyle"/>

    </GridLayout>
</LinearLayout>
