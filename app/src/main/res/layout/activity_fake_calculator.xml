<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="12dp"
    android:weightSum="10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.2"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121212"
            android:gravity="center_vertical|start"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FF9800"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/geek_font_bold"
            android:hint="输入假名检索..."
            android:textColorHint="#444444"
            android:maxLines="1" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:fillViewport="true">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:paddingBottom="16dp"
                android:textColor="#FF9800"
                android:textSize="18sp"
                android:fontFamily="@font/geek_font_bold"
                android:lineSpacingMultiplier="1.2" />
        </ScrollView>
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6.8"
        android:columnCount="5"
        android:rowCount="10">

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_1_1" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_1_2" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_1_3" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_1_4" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_1_5" style="@style/FiftyToneButtonStyle"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_2_1" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_2_2" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_2_3" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_2_4" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_2_5" style="@style/FiftyToneButtonStyle"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_3_1" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_3_2" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_3_3" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_3_4" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_3_5" style="@style/FiftyToneButtonStyle"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_4_1" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_4_2" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_4_3" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_4_4" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_4_5" style="@style/FiftyToneButtonStyle"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_5_1" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_5_2" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_5_3" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_5_4" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_5_5" style="@style/FiftyToneButtonStyle"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_6_1" style="@style/FiftyToneButtonStyle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_6_2" style="@style/FiftyToneButtonStyle"/>
